# Inject through your shell or credential manager. Node does not automatically load this file.
DEEPSEEK_API_KEY=
# local | demo | ima (optional legacy)
SOURCE_MODE=demo
# Optional: absolute authorized knowledge directory
# KNOWLEDGE_ROOT=/path/to/knowledge
# Disable live official access (local fallback only)
# OFFICIAL_SEARCH=0
PORT=3210
# Docker review deployment (set values in the platform, never commit secrets).
# HOST=0.0.0.0
# PORT=7860
# APP_ORIGIN=https://your-studio.ms.show
# APP_USER=team
# APP_PASSWORD=
# Optional exact HTTPS embedding origins, space separated:
# APP_FRAME_ANCESTORS=https://modelscope.cn https://www.modelscope.cn
# Optional observed internal proxy Host values (exact host:port, never a wildcard):
# APP_PROXY_HOSTS=
